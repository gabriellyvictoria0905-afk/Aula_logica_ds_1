algoritmo "Alerta_Seguranca"
var


estoque: inteiro
   
inicio



   escreva("qual a quantidade em estoque: ")
   leia(estoque)

   se (estoque < 10) entao
      escreval("emitir pedido de compra urgente!")
       senao
       escreval("estoque suficiente, NAO precisar faze.")
      
   fimse
   
   

   
   
   
fimalgoritmo